# === Privacy hard-guard (defense in depth) ===
# The public edition must NEVER contain patient-specific or individual-linking data.
# These patterns are excluded belt-and-suspenders, even though such files are not
# authored into this repository in the first place (the private N-of-1 overlay is
# kept entirely outside this repo).
_qa/
files/
backup/
staging/
tmp/
overlay/
*private*
*patient*
*_clinical_*
*_overlay_*

# "Proband" may be used in public, disease-level methodology. Do not ignore it
# by name: semantic case linkage is enforced by the release gate instead.

# === Grant applications (never published) ===
# Working dossiers for research-funding calls: named individuals, contact
# details, organisation IDs, budget figures and draft form answers. Kept in the
# working tree so each new call reuses the accumulated context, excluded from
# the published repository by design.
grants/

# === Standard ===
.DS_Store
*.log
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.env

# Optional molecular-dynamics runs are large, generated and non-canonical.
md-output/
*.dcd
state.tsv

# Browser-automation session artefacts. Retrieval via a real browser (publisher
# bot-blocks) drops page snapshots, console logs and network traces here. They
# are transient, they record the URLs a session visited, and they have no place
# in a public repository — the retrieval outcome belongs in
# files/fulltext/_retrieval_manifest.jsonl and the handoff card instead.
.playwright-mcp/

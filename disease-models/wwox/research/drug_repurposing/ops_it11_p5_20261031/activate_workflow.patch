diff --git a/.github/workflows/publish-shareable-view.yml b/.github/workflows/publish-shareable-view.yml
new file mode 100644
index 00000000..54fd5d88
--- /dev/null
+++ b/.github/workflows/publish-shareable-view.yml
@@ -0,0 +1,108 @@
+# Status of this text depends on where it lives. Under view/ (this path) it is a PROPOSAL: it does nothing. The same content under
+# .github/workflows/publish-shareable-view.yml is the active manual workflow (see DEPLOY.md, sections 6 and 9; section 8 is the rollback).
+# Activating it is an operator act (or the operator's explicit instruction to the Orchestrator): copy it there, enable
+# "GitHub Actions" as the Pages source in the repository settings, and run it by hand.
+#
+# What it does: verifies that every file of the shareable package, manifest.json included, equals the digest
+# in the table of view/DEPLOY.md (a second record, generated by the package command), and that the manifest
+# agrees with the files; then publishes exactly that directory as a static site with GitHub Pages. This is an
+# integrity check, not a content check: the content proof is `audit-shareable --dynamic`, run by hand before
+# the workflow is dispatched (DEPLOY.md, section 7). The Pages environment normally accepts deployments only
+# from the default branch, so the workflow is dispatched from that branch after the work has landed there.
+# It cannot be triggered by a push, a schedule or a pull request: workflow_dispatch is its only trigger.
+# Every `uses:` is pinned to the commit SHA of the release named in the trailing comment (looked up on 2026-10-29 with
+# `git ls-remote --tags` against the action repositories; see DEPLOY.md section 11). Re-check them before activation.
+name: Publish the shareable view (manual, proposal)
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: pages
+  cancel-in-progress: false
+
+env:
+  PACKAGE_DIR: disease-models/wwox/research/drug_repurposing/view/shareable_package
+  DEPLOY_DOC: disease-models/wwox/research/drug_repurposing/view/DEPLOY.md
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - name: Every package file, manifest.json included, equals its digest in DEPLOY.md and in the manifest
+        run: |
+          python3 - <<'PY'
+          import hashlib, json, os, re, sys
+          base, doc = os.environ["PACKAGE_DIR"], os.environ["DEPLOY_DOC"]
+          man = json.load(open(os.path.join(base, "manifest.json"), encoding="utf-8"))["files"]
+          table = {m.group(1): (int(m.group(2)), m.group(3)) for m in re.finditer(r"^\| `([^`]+)` \| (\d+) \| `([0-9a-f]{64})` \|$", open(doc, encoding="utf-8").read(), re.M)}
+          have = sorted(os.path.relpath(os.path.join(d, f), base) for d, _, fs in os.walk(base) for f in fs)
+          bad = []
+          for rel in have:
+              b = open(os.path.join(base, rel), "rb").read()
+              if rel not in table:
+                  bad.append("not in the DEPLOY.md table: " + rel)
+              elif table[rel] != (len(b), hashlib.sha256(b).hexdigest()):
+                  bad.append("differs from the DEPLOY.md table: " + rel)
+              if rel != "manifest.json" and (rel not in man or man[rel]["sha256"] != hashlib.sha256(b).hexdigest()):
+                  bad.append("differs from manifest.json: " + rel)
+          bad += ["listed but absent: " + r for r in table if r not in have]
+          for must in ("index.html", "NOTICE.md", "LICENSES/CC-BY-SA-3.0.txt"):
+              if must not in have:
+                  bad.append("required file absent: " + must)
+          print("\n".join(bad) or "package matches DEPLOY.md and its manifest")
+          sys.exit(1 if bad else 0)
+          PY
+
+  deploy:
+    needs: verify
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      pages: write
+      id-token: write
+    outputs:
+      page_url: ${{ steps.deployment.outputs.page_url }}
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d # v6.0.0
+      - uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
+        with:
+          path: ${{ env.PACKAGE_DIR }}
+      - id: deployment
+        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1
+
+  smoke:
+    # IT11 P5: after the deployment, fetch the live page and compare it with the package digest. A failure means the site is not what the table says
+    # (cache, wrong source, wrong branch); it changes nothing and has no permission beyond read.
+    needs: deploy
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - name: The live index.html equals the package file, answers 200 and carries the robots meta tag
+        env:
+          PAGE_URL: ${{ needs.deploy.outputs.page_url }}
+        run: |
+          set -eu
+          url="${PAGE_URL:-https://${GITHUB_REPOSITORY_OWNER}.github.io/${GITHUB_REPOSITORY#*/}/}"
+          for i in 1 2 3 4 5 6; do
+            code=$(curl -s -o live.html -w "%{http_code}" "$url" || true)
+            [ "$code" = "200" ] && break
+            sleep 20
+          done
+          echo "live status: $code at $url"
+          [ "$code" = "200" ]
+          want=$(sha256sum "$PACKAGE_DIR/index.html" | cut -d' ' -f1)
+          have=$(sha256sum live.html | cut -d' ' -f1)
+          echo "package $want"; echo "live    $have"
+          [ "$want" = "$have" ]
+          grep -c 'name="robots"' live.html || echo "no robots meta tag (indexing accepted)"

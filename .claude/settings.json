{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard_bash_command.py\"",
            "timeout": 10,
            "statusMessage": "Checking command against repository guards"
          }
        ]
      }
    ]
  }
}
